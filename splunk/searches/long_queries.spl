# Detection 2: Abnormally long DNS queries
# Detects unusually long domain names that may be generated by encoded or tunnelled traffic.
# Why it matters: long domains often carry encoded content or metadata.
# Fields required: _time, host, query_name, full_domain_length
# MITRE ATT&CK: T1048, T1071.004
# Analyst triage: review whether the long domain is unique and whether it coincides with process anomalies.

index=dns_analytics
| where full_domain_length > 70
| table _time host src_ip user query_name full_domain_length entropy
| sort - full_domain_length
